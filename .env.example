# Art direction -- palette, layout, typographic register, genre line, blurb,
# and the prompt handed to the image model. Without this the service falls back
# to a deterministic brief derived from a hash of the input.
ANTHROPIC_API_KEY=

# Cover artwork. Nano Banana Pro (the default) and FLUX.2 Pro run on fal and need
# FAL_API_KEY; the openai image model needs OPENAI_API_KEY. Without the key for the
# chosen model, covers render with a procedural vector motif instead.
FAL_API_KEY=
OPENAI_API_KEY=

# Optional overrides.
# COVERS_DIRECTOR=claude   # or openai, or none for no text model
# COVERS_CLAUDE_MODEL=claude-opus-5
# COVERS_IMAGE_MODEL=gpt-image-2
# COVERS_IMAGE_QUALITY=high
# COVERS_OUTPUT_DIR=out
# COVERS_LOG_LEVEL=INFO
# COVERS_SYSTEM_FONTS=0   # bundled open faces only, as on a server

# Books catalogue: MongoDB (e.g. Atlas). Required by bookworm.main:app. An empty
# collection is seeded from src/books/seed.json on first start.
MONGODB_URI=mongodb+srv://cluster0.example.mongodb.net
# Credentials, if not in the URI. Either one set overrides the URI's.
MONGODB_USERNAME=
MONGODB_PASSWORD=
# MONGODB_DB=bookworm
